# Copy to .env and replace every <...> value. Never commit .env.
# Passwords: avoid spaces, quotes and '#'; e.g. `openssl rand -hex 24`.

## Superuser (admin only — apps never use this)
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=<admin_password>
POSTGRES_DB=postgres
POSTGRES_HOST_PORT=5432

## Finance Tracker DB
POSTGRES_FT_DB=finance_app
POSTGRES_FT_USER=finance_app
POSTGRES_FT_PASSWORD=<ft_password>

## Ledger DB
POSTGRES_LEDGER_DB=ledger
POSTGRES_LEDGER_USER=ledger
POSTGRES_LEDGER_PASSWORD=<ledger_password>

## NSE Signal DB
POSTGRES_NSE_DB=nse_signal
POSTGRES_NSE_USER=nse_signal
POSTGRES_NSE_PASSWORD=<nse_password>

## More apps: add POSTGRES_<PREFIX>_DB/_USER/_PASSWORD here and the
## prefix to APPS=(...) in init/01-init-databases.sh.
