# Copy to .env

# Base domain; apps are served on <sub>.DOMAIN
DOMAIN=tinyserverlab.in

# Host port Cloudflare Tunnel forwards to (http://127.0.0.1:8080)
CADDY_HTTP_PORT=8080
# 127.0.0.1 = tunnel only; 0.0.0.0 = also reachable on the LAN
CADDY_BIND=127.0.0.1

# Upstreams = <container_name>:<container port> on the shared-web network
FT_UPSTREAM=finance-app:8090
LEDGER_UPSTREAM=ledger-app:8000
NSE_UPSTREAM=nse-signal-trader:8000
NSE_DASH_UPSTREAM=nse-signal-dashboard:8501
