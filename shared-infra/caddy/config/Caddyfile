# Shared Caddy — TinyServerLab
#
# Traffic: browser → Cloudflare (HTTPS) → cloudflared on the Pi
#          → http://127.0.0.1:8080 → this Caddy (:80) → app container
#
# One subdomain per app instead of path prefixes (/ft, /nse-signal): apps
# don't need base-path support (Streamlit, FastAPI and Next.js all break
# under an unconfigured prefix) and cookies stay isolated per app.
#
# {$VAR:default} values come from caddy/.env.

{
	# TLS is terminated by Cloudflare; Caddy only speaks plain HTTP on the Pi.
	auto_https off

	servers {
		# Trust X-Forwarded-* from cloudflared (arrives via the Docker gateway)
		# so apps see the real client IP.
		trusted_proxies static private_ranges
	}
}

(common) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format console
	}
}

# Finance Tracker
http://ft.{$DOMAIN:tinyserverlab.in} {
	import common
	reverse_proxy {$FT_UPSTREAM:finance-app:8000}
}

# Ledger
http://ledger.{$DOMAIN:tinyserverlab.in} {
	import common
	reverse_proxy {$LEDGER_UPSTREAM:ledger-app:8000}
}

# NSE Signal — Streamlit dashboard (websockets are proxied automatically)
http://nse-dash.{$DOMAIN:tinyserverlab.in} {
	import common
	reverse_proxy {$NSE_DASH_UPSTREAM:nse-signal-dashboard:8501}
}

